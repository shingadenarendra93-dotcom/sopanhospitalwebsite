{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated patient or staff user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "admin", "doctor"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Patient OPD consultation appointment record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientName": { "type": "string" },
        "contactNumber": { "type": "string" },
        "age": { "type": "string" },
        "gender": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "department": { "type": "string" },
        "tokenNumber": { "type": "string" },
        "doctor": { "type": "string" },
        "conditionContext": { "type": "string" },
        "status": { "type": "string", "enum": ["CONFIRMED", "CANCELLED", "COMPLETED"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["patientName", "contactNumber", "date", "timeSlot", "tokenNumber", "createdAt"]
    },
    "PatientFeedback": {
      "title": "PatientFeedback",
      "description": "Patient experience feedback and rating record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "overallRating": { "type": "number" },
        "drAttentiveness": { "type": "number" },
        "diagnosisClarity": { "type": "number" },
        "waitTimeScore": { "type": "number" },
        "staffCourtesy": { "type": "number" },
        "cleanlinessFacility": { "type": "number" },
        "recommend": { "type": "boolean" },
        "reviewText": { "type": "string" },
        "improvementSuggestions": { "type": "string" },
        "consultationType": { "type": "string" },
        "department": { "type": "string" },
        "opdToken": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "authorName": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["overallRating", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message in Gemini multi-turn conversation thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model", "system"] },
        "content": { "type": "string" },
        "model": { "type": "string" },
        "groundingType": { "type": "string" },
        "sources": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["role", "content", "timestamp"]
    },
    "HospitalEvent": {
      "title": "HospitalEvent",
      "description": "Hospital photograph archive and special occasion documentation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "location": { "type": "string" },
        "leadClinician": { "type": "string" },
        "summary": { "type": "string" },
        "attendeesCount": { "type": "string" },
        "imageUrl": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "keyHighlights": { "type": "array", "items": { "type": "string" } },
        "addedBy": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "date", "imageUrl"]
    },
    "HospitalSettings": {
      "title": "HospitalSettings",
      "description": "Hospital configuration settings such as consultation fee and OPD quotas",
      "type": "object",
      "properties": {
        "consultationFee": { "type": "number" },
        "opdCapacity": { "type": "number" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "WebsiteData": {
      "title": "WebsiteData",
      "description": "Patient intake and inquiries saved into website_data collection",
      "type": "object",
      "properties": {
        "patientName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "age": { "type": "string" },
        "gender": { "type": "string" },
        "department": { "type": "string" },
        "chiefComplaint": { "type": "string" },
        "preferredDate": { "type": "string" },
        "notes": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["patientName", "phone", "createdAt"]
    }
  },
  "firestore": {
    "/website_data/{docId}": {
      "schema": { "$ref": "#/entities/WebsiteData" },
      "description": "Patient intake records stored in website_data collection"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles indexed by Firebase Auth UID"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Patient clinic appointments"
    },
    "/feedbacks/{feedbackId}": {
      "schema": { "$ref": "#/entities/PatientFeedback" },
      "description": "Public and anonymous patient experience reviews"
    },
    "/hospital_events/{eventId}": {
      "schema": { "$ref": "#/entities/HospitalEvent" },
      "description": "Hospital photographs of special occasions and clinical events"
    },
    "/hospital_settings/{settingId}": {
      "schema": { "$ref": "#/entities/HospitalSettings" },
      "description": "Global hospital settings like home page consultation fee"
    },
    "/users/{userId}/chats/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "User-specific multi-turn AI consultation chat history"
    }
  }
}
